generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  SALES_AGENT
  CONTENT_EDITOR
  CUSTOMER
}

enum PropertyType {
  LAND
  HOUSE
  FLAT
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum InventoryStatus {
  AVAILABLE
  BOOKED
  SOLD
  UPCOMING
}

enum LeadStage {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  NEGOTIATION
  BOOKED
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  FACEBOOK
  REFERRAL
  WALK_IN
}

enum MediaType {
  IMAGE
  VIDEO
  PANORAMA
  MODEL_3D
  FLOOR_PLAN
  DOCUMENT
}

enum VideoKind {
  SHORT
  VIDEO
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  phone         String?
  passwordHash  String?
  role          Role            @default(CUSTOMER)
  twoFactorAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  assignedLeads Lead[]          @relation("AssignedLeads")
  createdLeads  Lead[]          @relation("CreatedLeads")
  visits        Visit[]
  auditLogs     AuditLog[]
  savedListings SavedProperty[]
  notifications Notification[]
  pushTokens    AdminPushToken[]
}

model Project {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  location    String
  description String
  coverImage  String
  gallery     String[]       @default([])
  videoUrl    String?
  totalUnits  Int
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  properties  Property[]
  videos      ProjectVideo[]
}

model ProjectVideo {
  id           String    @id @default(cuid())
  projectId    String
  kind         VideoKind
  title        String
  description  String
  youtubeUrl   String
  youtubeId    String
  thumbnailUrl String
  published    Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, published, sortOrder])
}

model Property {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  type        PropertyType
  status      PropertyStatus  @default(DRAFT)
  inventory   InventoryStatus @default(AVAILABLE)
  location    String
  city        String
  description String
  priceMinor  BigInt
  currency    String          @default("BDT")
  area        Decimal         @db.Decimal(12, 2)
  areaUnit    String          @default("sq ft")
  bedrooms    Int?
  bathrooms   Int?
  floor       Int?
  facing      String?
  featured    Boolean         @default(false)
  verified    Boolean         @default(false)
  focalX      Int             @default(50)
  focalY      Int             @default(50)
  // Web-parity display fields the relational columns do not cover: Bengali
  // texts, image gallery, summary, amenities, badges, 3D/360/video flags,
  // completion note and the project label/slug.
  webFields   Json?
  // Catalogue ordering shared by the public site and the admin panel.
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  publishedAt DateTime?
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  media       Media[]
  leads       Lead[]
  savedBy     SavedProperty[]
  units       Unit[]

  @@index([status, inventory, type, priceMinor])
  @@index([city, type])
  @@index([projectId])
}

model Unit {
  id         String          @id @default(cuid())
  propertyId String
  label      String
  floor      Int
  area       Decimal         @db.Decimal(12, 2)
  priceMinor BigInt
  status     InventoryStatus @default(AVAILABLE)
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, label])
  @@index([status, floor])
}

model Media {
  id         String    @id @default(cuid())
  propertyId String
  type       MediaType
  url        String
  altText    String
  caption    String?
  blurData   String?
  focalX     Int       @default(50)
  focalY     Int       @default(50)
  sortOrder  Int       @default(0)
  metadata   Json?
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type, sortOrder])
}

model Lead {
  id          String         @id @default(cuid())
  name        String
  email       String
  phone       String
  note        String?
  stage       LeadStage      @default(NEW)
  source      LeadSource     @default(WEBSITE)
  score       Int            @default(0)
  propertyId  String?
  assignedTo  String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  nextFollow  DateTime?
  property    Property?      @relation(fields: [propertyId], references: [id])
  assignee    User?          @relation("AssignedLeads", fields: [assignedTo], references: [id])
  createdBy   User?          @relation("CreatedLeads", fields: [createdById], references: [id])
  activities  LeadActivity[]
  visits      Visit[]

  @@index([stage, assignedTo, updatedAt])
  @@index([email, phone])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  kind      String
  body      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Visit {
  id        String   @id @default(cuid())
  leadId    String
  agentId   String
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId, startsAt])
}

model SavedProperty {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

// In-app notifications. "ADMIN" rows feed the admin panel bell (viewing requests,
// lead updates); "USER" rows are scoped to a signed-in customer via userId.
model Notification {
  id        String    @id @default(cuid())
  audience  String    @default("ADMIN")
  userId    String?
  type      String    @default("LEAD")
  title     String
  body      String?
  link      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([audience, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
}


model AdminPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
